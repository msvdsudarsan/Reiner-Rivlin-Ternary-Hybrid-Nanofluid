units lj
atom_style bond
boundary p p p
read_data kg_chains.data
special_bonds fene
neighbor 0.4 bin
neigh_modify every 1 delay 1 check yes
bond_style fene
bond_coeff 1 30.0 1.5 1.0 1.0
pair_style lj/cut 1.12246152962189
pair_modify shift yes
pair_coeff 1 1 1.0 1.0 1.12246152962189
# soft push-off to remove overlaps
pair_style soft 1.12246
pair_coeff 1 1 0.0
variable pre equal ramp(1,60)
fix pp all adapt 1 pair soft a 1 1 v_pre
fix lan all langevin 1.0 1.0 1.0 4242
fix nv all nve/limit 0.1
timestep 0.01
run 3000
unfix pp
unfix nv
pair_style lj/cut 1.12246152962189
pair_modify shift yes
pair_coeff 1 1 1.0 1.0 1.12246152962189
fix nv all nve/limit 0.05
run 3000
unfix nv
fix nv all nve
timestep 0.005
run 100000
write_data kg_equil.data
